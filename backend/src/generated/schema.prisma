generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                     String             @id @default(uuid())
  nombre                 String
  email                  String             @unique
  passwordHash           String
  rol                    Rol
  fechaCreacion          DateTime           @default(now())
  telefono               String?
  dni                    String?            @unique
  requiereCambioPassword Boolean            @default(true)
  activacionesCuenta     ActivacionCuenta[]
  notificaciones         Notificacion[]
  alumno                 Alumno?
  profesor               Profesor?

  @@map("usuarios")
}

model ActivacionCuenta {
  id          String    @id @default(uuid())
  usuarioId   String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String?
  resendCount Int       @default(0)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("activaciones_cuenta")
}

model Profesor {
  id                String                  @id
  licenciaConducir  String
  telefono          String
  activo            Boolean                 @default(true)
  permisosLicencias String[]                @default([])
  alumnosAsignados  Alumno[]
  clasesDirecto     ClaseDirecto[]
  clases            ClasePractica[]
  hojasRuta         HojaRuta[]
  horarioBloques    ProfesorHorarioBloque[]
  usuario           Usuario                 @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profesores")
}

model ProfesorHorarioBloque {
  id         String   @id @default(uuid())
  profesorId String
  diaSemana  Int
  horaInicio String
  horaFin    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  profesor   Profesor @relation(fields: [profesorId], references: [id], onDelete: Cascade)

  @@index([profesorId, diaSemana])
  @@map("profesor_horarios_bloque")
}

model Alumno {
  id                        String            @id
  tipoLicenciaObjetivo      String
  horasPracticasCompletadas Int               @default(0)
  profesorAsignadoId        String?
  activo                    Boolean           @default(true)
  fechaNacimiento           DateTime?
  usuario                   Usuario           @relation(fields: [id], references: [id], onDelete: Cascade)
  profesorAsignado          Profesor?         @relation(fields: [profesorAsignadoId], references: [id])
  clases                    ClasePractica[]
  bonosComprados            CompraBono[]
  examenes                  Examen[]
  facturas                  Factura[]
  pagos                     Pago[]
  matriculas                Matricula[]
  solicitudesExamen         SolicitudExamen[]
  temariosProgreso          TemarioProgreso[]
  testsPractica             TestPractica[]
  examenesDGT               ExamenDGTAlumno[]
  documentosAlumno          DocumentoAlumno[]
  hojasRuta                 HojaRuta[]

  @@map("alumnos")
}

model DocumentoAlumno {
  id            String                   @id @default(uuid())
  alumnoId      String
  tipo          String
  estado        String                   @default("PENDIENTE_VALIDACION")
  observaciones String?
  activo        Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  alumno        Alumno                   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  archivos      DocumentoAlumnoArchivo[]

  @@index([alumnoId])
  @@index([estado])
  @@map("documentos_alumno")
}

model DocumentoAlumnoArchivo {
  id             String          @id @default(uuid())
  documentoId    String
  nombreOriginal String
  nombreArchivo  String
  mimeType       String
  tamanioBytes   Int
  ruta           String
  createdAt      DateTime        @default(now())
  documento      DocumentoAlumno @relation(fields: [documentoId], references: [id], onDelete: Cascade)

  @@index([documentoId])
  @@map("documentos_alumno_archivos")
}

model Temario {
  id                   String            @id @default(uuid())
  titulo               String
  descripcion          String?
  orden                Int               @default(0)
  tipoLicenciaObjetivo String[]
  documentacionRuta    String?
  claseDirectoVideoUrl String?
  progreso             TemarioProgreso[]
  testsPractica        TestPractica[]

  @@index([tipoLicenciaObjetivo], type: Gin)
  @@map("temarios")
}

model TemarioProgreso {
  id             String    @id @default(uuid())
  alumnoId       String
  temarioId      String
  revisado       Boolean   @default(false)
  dominio        Int       @default(0)
  ultimaRevision DateTime?
  alumno         Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  temario        Temario   @relation(fields: [temarioId], references: [id], onDelete: Cascade)

  @@index([alumnoId])
  @@index([temarioId])
  @@map("temarios_progreso")
}

model ClaseDirecto {
  id               String    @id @default(uuid())
  titulo           String
  descripcion      String?
  videoUrl         String
  duracionSegundos Int       @default(0)
  profesorId       String?
  permiso          String    @default("B")
  activa           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  profesor         Profesor? @relation(fields: [profesorId], references: [id])

  @@index([permiso])
  @@index([activa])
  @@index([profesorId])
  @@map("clases_directo")
}

model TestPractica {
  id                  String   @id @default(uuid())
  alumnoId            String
  temarioId           String?
  fecha               DateTime @default(now())
  resultado           String
  respuestasCorrectas Int
  totalPreguntas      Int
  alumno              Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  temario             Temario? @relation(fields: [temarioId], references: [id])

  @@index([alumnoId])
  @@index([temarioId])
  @@index([fecha])
  @@map("tests_practica")
}

model PreguntaDGT {
  id          String                 @id @default(uuid())
  licencia    String[]
  enunciado   String
  imagenRuta  String?
  explicacion String?
  activa      Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  respuestas  RespuestaPreguntaDGT[]

  @@index([activa])
  @@index([createdAt])
  @@index([licencia], type: Gin)
  @@map("preguntas_dgt")
}

model RespuestaPreguntaDGT {
  id         String      @id @default(uuid())
  preguntaId String
  texto      String
  correcta   Boolean     @default(false)
  orden      Int?
  pregunta   PreguntaDGT @relation(fields: [preguntaId], references: [id], onDelete: Cascade)

  @@index([preguntaId])
  @@map("respuestas_pregunta_dgt")
}

model ExamenDGTAlumno {
  id               String   @id @default(uuid())
  alumnoId         String
  licencia         String
  totalPreguntas   Int
  aciertos         Int
  fallos           Int
  aprobado         Boolean
  duracionSegundos Int?
  fecha            DateTime @default(now())
  alumno           Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@index([alumnoId])
  @@index([licencia])
  @@index([fecha])
  @@map("examenes_dgt_alumno")
}

model Bono {
  id              String       @id @default(uuid())
  nombre          String
  descripcion     String?
  clasesIncluidas Int
  precio          Decimal      @default(0) @db.Decimal(10, 2)
  validezDias     Int          @default(90)
  activo          Boolean      @default(true)
  compras         CompraBono[]

  @@map("bonos")
}

model CompraBono {
  id                String          @id @default(uuid())
  alumnoId          String
  bonoId            String
  clasesCompradas   Int
  clasesConsumidas  Int             @default(0)
  pagado            Boolean         @default(false)
  fechaCompra       DateTime        @default(now())
  fechaValidezHasta DateTime
  pagos             Pago[]
  facturas          Factura[]
  clases            ClasePractica[]
  alumno            Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  bono              Bono            @relation(fields: [bonoId], references: [id])

  @@index([alumnoId])
  @@index([bonoId])
  @@index([fechaCompra])
  @@map("compras_bonos")
}

model SolicitudExamen {
  id              String    @id @default(uuid())
  alumnoId        String
  tipo            String
  estado          String    @default("PENDIENTE")
  fechaSolicitud  DateTime  @default(now())
  fechaProgramada DateTime?
  erroresExamen   Int?
  aciertosExamen  Int?
  observaciones   String?
  alumno          Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@index([alumnoId])
  @@index([tipo])
  @@index([estado])
  @@map("solicitudes_examen")
}

model ConvocatoriaExamen {
  id         String   @id @default(uuid())
  fecha      DateTime
  licencia   String
  tipoExamen String
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fecha, licencia, tipoExamen])
  @@index([fecha])
  @@index([licencia])
  @@index([tipoExamen])
  @@index([activo])
  @@map("convocatorias_examen")
}

model Vehiculo {
  id          String          @id @default(uuid())
  matricula   String          @unique
  marca       String?
  modelo      String?
  tipoPermiso String
  activo      Boolean         @default(true)
  imagenRuta  String?
  clases      ClasePractica[]

  @@map("vehiculos")
}

model ClasePractica {
  id                       String      @id @default(uuid())
  alumnoId                 String
  profesorId               String
  vehiculoId               String
  compraBonoId             String?
  fecha                    DateTime
  duracion                 Int
  estado                   String
  metodoPago               String      @default("INDIVIDUAL")
  pagoLimiteAt             DateTime?
  canceladaPor             String?
  canceladaConPenalizacion Boolean     @default(false)
  alumno                   Alumno      @relation(fields: [alumnoId], references: [id])
  profesor                 Profesor    @relation(fields: [profesorId], references: [id])
  vehiculo                 Vehiculo    @relation(fields: [vehiculoId], references: [id])
  compraBono               CompraBono? @relation(fields: [compraBonoId], references: [id], onDelete: SetNull)
  pagos                    Pago[]
  facturas                 Factura[]
  hojaRuta                 HojaRuta?

  @@index([alumnoId])
  @@index([profesorId])
  @@index([vehiculoId])
  @@index([compraBonoId])
  @@index([fecha])
  @@map("clases_practicas")
}

model HojaRuta {
  id                    String          @id @default(uuid())
  clasePracticaId       String          @unique
  profesorId            String
  alumnoId              String
  estado                String          @default("EN_CURSO")
  observacionesProfesor String?
  kilometrosInicio      Int?
  kilometrosFin         Int?
  combustibleInicioPct  Int?
  combustibleFinPct     Int?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  finalizedAt           DateTime?
  clasePractica         ClasePractica   @relation(fields: [clasePracticaId], references: [id], onDelete: Cascade)
  profesor              Profesor        @relation(fields: [profesorId], references: [id], onDelete: Restrict)
  alumno                Alumno          @relation(fields: [alumnoId], references: [id], onDelete: Restrict)
  faltas                HojaRutaFalta[]

  @@index([profesorId])
  @@index([alumnoId])
  @@index([estado])
  @@index([createdAt])
  @@map("hojas_ruta")
}

model HojaRutaFalta {
  id          String                 @id @default(uuid())
  hojaRutaId  String
  hora        String
  tipo        String
  categoria   String
  descripcion String
  orden       Int                    @default(0)
  catalogoId  String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  hojaRuta    HojaRuta               @relation(fields: [hojaRutaId], references: [id], onDelete: Cascade)
  catalogo    HojaRutaFaltaCatalogo? @relation(fields: [catalogoId], references: [id], onDelete: SetNull)

  @@index([hojaRutaId])
  @@index([tipo])
  @@index([catalogoId])
  @@map("hojas_ruta_faltas")
}

model HojaRutaFaltaCatalogo {
  id          String          @id @default(uuid())
  tipo        String
  categoria   String
  descripcion String
  activo      Boolean         @default(true)
  orden       Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  faltas      HojaRutaFalta[]

  @@index([tipo])
  @@index([activo])
  @@index([orden])
  @@map("hojas_ruta_faltas_catalogo")
}

model Examen {
  id       String   @id @default(uuid())
  alumnoId String
  tipo     String
  fecha    DateTime
  estado   String
  alumno   Alumno   @relation(fields: [alumnoId], references: [id])

  @@index([alumnoId])
  @@index([fecha])
  @@map("examenes")
}

model Promocion {
  id                       String      @id @default(uuid())
  nombre                   String
  descripcion              String?
  precioOriginal           Decimal     @db.Decimal(10, 2)
  precioPromocional        Decimal     @db.Decimal(10, 2)
  licenciasAplicables      String[]
  imagenRuta               String?
  fechaInicio              DateTime?
  fechaFin                 DateTime?
  activa                   Boolean     @default(true)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  requiereCarnetEstudiante Boolean     @default(false)
  edadMinima               Int?
  edadMaxima               Int?
  requiereFidelidad        Boolean     @default(false)
  matriculas               Matricula[]

  @@map("promociones")
}

enum TipoPrecio {
  FIJO
  VARIABLE
  POR_CLASE
  POR_EXAMEN
}

model TarifaConcepto {
  id          String                    @id @default(uuid())
  permiso     String
  concepto    String
  precio      Decimal                   @db.Decimal(10, 2)
  tipo        TipoPrecio
  descripcion String?
  activa      Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  historial   TarifaConceptoHistorial[]
  matriculas  MatriculaConcepto[]

  @@unique([permiso, concepto])
  @@index([permiso])
  @@index([activa])
  @@map("tarifas_concepto")
}

model TarifaConceptoHistorial {
  id               String         @id @default(uuid())
  tarifaConceptoId String
  permiso          String
  concepto         String
  precioAnterior   Decimal?       @db.Decimal(10, 2)
  precioNuevo      Decimal        @db.Decimal(10, 2)
  motivo           String?
  usuarioId        String?
  createdAt        DateTime       @default(now())
  tarifaConcepto   TarifaConcepto @relation(fields: [tarifaConceptoId], references: [id], onDelete: Cascade)

  @@index([tarifaConceptoId])
  @@index([permiso])
  @@index([createdAt])
  @@map("tarifas_concepto_historial")
}

model TarifaMatricula {
  id        String   @id @default(uuid())
  licencia  String   @unique
  precio    Decimal  @db.Decimal(10, 2)
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tarifas_matricula")
}

model Matricula {
  id            String              @id @default(uuid())
  alumnoId      String
  licencia      String
  precioBase    Decimal             @db.Decimal(10, 2)
  precioFinal   Decimal             @db.Decimal(10, 2)
  promocionId   String?
  estado        String              @default("PENDIENTE")
  fechaCreacion DateTime            @default(now())
  fechaPago     DateTime?
  observaciones String?
  facturas      Factura[]
  pagos         Pago[]
  conceptos     MatriculaConcepto[]
  alumno        Alumno              @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  promocion     Promocion?          @relation(fields: [promocionId], references: [id])

  @@index([alumnoId])
  @@index([estado])
  @@map("matriculas")
}

model Pago {
  id                      String         @id @default(uuid())
  alumnoId                String
  matriculaId             String?
  compraBonoId            String?
  clasePracticaId         String?
  tipo                    String
  concepto                String
  permiso                 String
  importe                 Decimal        @db.Decimal(10, 2)
  estado                  String         @default("PENDIENTE")
  convocatoriasIncluidas  Int            @default(2)
  convocatoriasConsumidas Int            @default(0)
  fechaCreacion           DateTime       @default(now())
  fechaPago               DateTime?
  numeroFacturaPago       String?
  observaciones           String?
  alumno                  Alumno         @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  matricula               Matricula?     @relation(fields: [matriculaId], references: [id], onDelete: SetNull)
  compraBono              CompraBono?    @relation(fields: [compraBonoId], references: [id], onDelete: SetNull)
  clasePractica           ClasePractica? @relation(fields: [clasePracticaId], references: [id], onDelete: SetNull)

  @@index([alumnoId])
  @@index([matriculaId])
  @@index([compraBonoId])
  @@index([clasePracticaId])
  @@index([estado])
  @@index([tipo])
  @@index([permiso])
  @@index([fechaCreacion])
  @@map("pagos")
}

model TheoreticalExamProcessBatch {
  id           String                            @id
  status       String
  mode         String
  targetDate   DateTime                          @db.Date
  seed         String?
  operator     String?
  reason       String?
  dryRun       Boolean                           @default(false)
  summary      Json                              @default("{}")
  createdAt    DateTime                          @default(now())
  appliedAt    DateTime?
  rolledBackAt DateTime?
  solicitudes  TheoreticalExamProcessSolicitud[]
  pagos        TheoreticalExamProcessPago[]

  @@index([status])
  @@index([createdAt])
  @@map("theoretical_exam_process_batches")
}

model TheoreticalExamProcessSolicitud {
  id             BigInt                      @id @default(autoincrement())
  batchId        String
  solicitudId    String
  alumnoId       String
  beforeEstado   String
  beforeErrores  Int?
  beforeAciertos Int?
  afterEstado    String
  afterErrores   Int
  afterAciertos  Int
  revertedAt     DateTime?
  conflictReason String?
  batch          TheoreticalExamProcessBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, solicitudId])
  @@index([batchId])
  @@index([solicitudId])
  @@map("theoretical_exam_process_solicitudes")
}

model TheoreticalExamProcessPago {
  id                            BigInt                      @id @default(autoincrement())
  batchId                       String
  pagoId                        String
  alumnoId                      String
  beforeConvocatoriasConsumidas Int
  afterConvocatoriasConsumidas  Int
  applied                       Boolean                     @default(true)
  revertedAt                    DateTime?
  conflictReason                String?
  batch                         TheoreticalExamProcessBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, pagoId])
  @@index([batchId])
  @@index([pagoId])
  @@map("theoretical_exam_process_pagos")
}

model MatriculaConcepto {
  id               String         @id @default(uuid())
  matriculaId      String
  tarifaConceptoId String
  cantidad         Int            @default(1)
  precioUnitario   Decimal        @db.Decimal(10, 2)
  subtotal         Decimal        @db.Decimal(10, 2)
  activo           Boolean        @default(true)
  observaciones    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  matricula        Matricula      @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  tarifaConcepto   TarifaConcepto @relation(fields: [tarifaConceptoId], references: [id], onDelete: Restrict)

  @@index([matriculaId])
  @@index([tarifaConceptoId])
  @@map("matriculas_conceptos")
}

model Factura {
  id              String         @id @default(uuid())
  numero          String         @unique
  alumnoId        String
  matriculaId     String?
  compraBonoId    String?
  clasePracticaId String?
  concepto        String
  baseImponible   Decimal        @db.Decimal(10, 2)
  descuento       Decimal        @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  estado          String         @default("EMITIDA")
  fechaEmision    DateTime       @default(now())
  fechaPago       DateTime?
  alumno          Alumno         @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  matricula       Matricula?     @relation(fields: [matriculaId], references: [id], onDelete: Cascade)
  compraBono      CompraBono?    @relation(fields: [compraBonoId], references: [id], onDelete: SetNull)
  clasePractica   ClasePractica? @relation(fields: [clasePracticaId], references: [id], onDelete: SetNull)

  @@index([alumnoId])
  @@index([matriculaId])
  @@index([compraBonoId])
  @@index([clasePracticaId])
  @@index([estado])
  @@index([fechaEmision])
  @@map("facturas")
}

model Notificacion {
  id        String    @id @default(uuid())
  usuarioId String
  tipo      String
  titulo    String
  mensaje   String
  metadata  Json?
  leida     Boolean   @default(false)
  createdAt DateTime  @default(now())
  readAt    DateTime?
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([tipo])
  @@index([leida])
  @@index([createdAt])
  @@map("notificaciones")
}

enum Rol {
  ADMIN
  PROFESOR
  ALUMNO
}
