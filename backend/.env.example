PORT=5000
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/autodrive_db
JWT_SECRET=replace-with-secure-secret

# Tasa DGT 2.1 coverage config
TASA_DGT_CONCEPTO_PATTERN=Tasa DGT (Tasa 2.1)
TASA_DGT_MAX_SUSPENSOS=2
TASA_DGT_IMPORTE_DEFAULT=94.05

# Default renewal rules
RENOVACION_DIAS_ESPERA_DEFAULT=0
RENOVACION_CLASES_OBLIGATORIAS_DEFAULT=0

# Renewal rules by licencia
RENOVACION_DIAS_ESPERA_A1=7
RENOVACION_CLASES_OBLIGATORIAS_A1=2
RENOVACION_DIAS_ESPERA_A2=10
RENOVACION_CLASES_OBLIGATORIAS_A2=3
RENOVACION_DIAS_ESPERA_A=7
RENOVACION_CLASES_OBLIGATORIAS_A=2
RENOVACION_DIAS_ESPERA_B=15
RENOVACION_CLASES_OBLIGATORIAS_B=3
RENOVACION_DIAS_ESPERA_C=21
RENOVACION_CLASES_OBLIGATORIAS_C=4
RENOVACION_DIAS_ESPERA_D=21
RENOVACION_CLASES_OBLIGATORIAS_D=5
RENOVACION_DIAS_ESPERA_E=14
RENOVACION_CLASES_OBLIGATORIAS_E=3
