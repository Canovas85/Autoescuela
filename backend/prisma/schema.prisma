generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id                     String             @id @default(uuid())
  nombre                 String
  dni                    String?            @unique
  email                  String             @unique
  telefono               String?
  passwordHash           String
  requiereCambioPassword Boolean            @default(true)
  rol                    Rol
  fechaCreacion          DateTime           @default(now())
  alumno                 Alumno?
  profesor               Profesor?
  activacionesCuenta     ActivacionCuenta[]

  @@map("usuarios")
}

model ActivacionCuenta {
  id          String    @id @default(uuid())
  usuarioId   String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String?
  resendCount Int       @default(0)
  usuario     Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([expiresAt])
  @@index([usedAt])
  @@map("activaciones_cuenta")
}

model Profesor {
  id                String          @id
  licenciaConducir  String
  permisosLicencias String[]        @default([])
  telefono          String
  activo            Boolean         @default(true)
  alumnosAsignados  Alumno[]
  clases ClasePractica[]
  clasesDirecto ClaseDirecto[]
  usuario           Usuario         @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profesores")
}

model Alumno {
  id                        String            @id
  tipoLicenciaObjetivo      String
  fechaNacimiento           DateTime?
  horasPracticasCompletadas Int               @default(0)
  matriculaPagada           Boolean           @default(false)
  fechaMatriculaPago        DateTime?
  profesorAsignadoId        String?
  usuario                   Usuario           @relation(fields: [id], references: [id], onDelete: Cascade)
  profesorAsignado          Profesor?         @relation(fields: [profesorAsignadoId], references: [id])
  activo                    Boolean           @default(true)
  clases                    ClasePractica[]
  examenes                  Examen[]
  testsPractica             TestPractica[]
  temariosProgreso          TemarioProgreso[]
  bonosComprados            CompraBono[]
  solicitudesExamen         SolicitudExamen[]

  @@map("alumnos")
}

model Temario {
  id                   String            @id @default(uuid())
  titulo               String
  descripcion          String?
  tipoLicenciaObjetivo String
  orden                Int               @default(0)
  progreso             TemarioProgreso[]
  testsPractica        TestPractica[]

  @@index([tipoLicenciaObjetivo])
  @@map("temarios")
}

model TemarioProgreso {
  id             String    @id @default(uuid())
  alumnoId       String
  temarioId      String
  revisado       Boolean   @default(false)
  dominio        Int       @default(0)
  ultimaRevision DateTime?
  alumno         Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  temario        Temario   @relation(fields: [temarioId], references: [id], onDelete: Cascade)

  @@index([alumnoId])
  @@index([temarioId])
  @@map("temarios_progreso")
}


model ClaseDirecto {
  id String @id @default(uuid())
  titulo String
  descripcion String?
  videoUrl String
  duracionSegundos Int @default(0)
  profesorId String?
  permiso String @default("B")
  activa Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  profesor Profesor? @relation(fields: [profesorId], references: [id])

  @@index([permiso])
  @@index([activa])
  @@index([profesorId])
  @@map("clases_directo")
}


model TestPractica {
  id                  String   @id @default(uuid())
  alumnoId            String
  temarioId           String?
  fecha               DateTime @default(now())
  resultado           String
  respuestasCorrectas Int
  totalPreguntas      Int
  alumno              Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  temario             Temario? @relation(fields: [temarioId], references: [id])

  @@index([alumnoId])
  @@index([temarioId])
  @@index([fecha])
  @@map("tests_practica")
}

model Bono {
  id              String       @id @default(uuid())
  nombre          String
  descripcion     String?
  clasesIncluidas Int
  validezDias     Int          @default(90)
  activo          Boolean      @default(true)
  compras         CompraBono[]

  @@map("bonos")
}

model CompraBono {
  id                String   @id @default(uuid())
  alumnoId          String
  bonoId            String
  clasesCompradas   Int
  clasesConsumidas  Int      @default(0)
  pagado            Boolean  @default(false)
  fechaCompra       DateTime @default(now())
  fechaValidezHasta DateTime
  alumno            Alumno   @relation(fields: [alumnoId], references: [id], onDelete: Cascade)
  bono              Bono     @relation(fields: [bonoId], references: [id])

  @@index([alumnoId])
  @@index([bonoId])
  @@index([fechaCompra])
  @@map("compras_bonos")
}

model SolicitudExamen {
  id              String    @id @default(uuid())
  alumnoId        String
  tipo            String
  estado          String    @default("PENDIENTE")
  fechaSolicitud  DateTime  @default(now())
  fechaProgramada DateTime?
  observaciones   String?
  alumno          Alumno    @relation(fields: [alumnoId], references: [id], onDelete: Cascade)

  @@index([alumnoId])
  @@index([tipo])
  @@index([estado])
  @@map("solicitudes_examen")
}

model Vehiculo {
  id          String          @id @default(uuid())
  matricula   String          @unique
  marca       String?
  modelo      String?
  tipoPermiso String
  imagenRuta  String?
  activo      Boolean         @default(true)
  clases      ClasePractica[]

  @@map("vehiculos")
}

model ClasePractica {
  id         String   @id @default(uuid())
  alumnoId   String
  profesorId String
  vehiculoId String
  fecha      DateTime
  duracion   Int
  estado     String
  alumno     Alumno   @relation(fields: [alumnoId], references: [id])
  profesor   Profesor @relation(fields: [profesorId], references: [id])
  vehiculo   Vehiculo @relation(fields: [vehiculoId], references: [id])

  @@index([alumnoId])
  @@index([profesorId])
  @@index([vehiculoId])
  @@index([fecha])
  @@map("clases_practicas")
}

model Examen {
  id       String   @id @default(uuid())
  alumnoId String
  tipo     String
  fecha    DateTime
  estado   String
  alumno   Alumno   @relation(fields: [alumnoId], references: [id])

  @@index([alumnoId])
  @@index([fecha])
  @@map("examenes")
}

model Promocion {
  id String @id @default(uuid())

  nombre      String
  descripcion String?

  precioOriginal    Decimal @db.Decimal(10, 2)
  precioPromocional Decimal @db.Decimal(10, 2)

  licenciasAplicables String[]

  imagenRuta String?

  fechaInicio DateTime?
  fechaFin    DateTime?

  activa Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("promociones")
}

enum Rol {
  ADMIN
  PROFESOR
  ALUMNO
}
